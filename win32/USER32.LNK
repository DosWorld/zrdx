system nt_dll
name USER32.DLL
file USER32.OBJ
file U32FMT.OBJ
file U32MISC.OBJ
option nodefaultlibs
export CharUpperA='_CharUpperA@4'
export CharLowerA='_CharLowerA@4'
export CharUpperW='_CharUpperW@4'
export CharLowerW='_CharLowerW@4'
export CharUpperBuffA='_CharUpperBuffA@8'
export CharLowerBuffA='_CharLowerBuffA@8'
export CharUpperBuffW='_CharUpperBuffW@8'
export CharLowerBuffW='_CharLowerBuffW@8'
export IsCharAlphaA='_IsCharAlphaA@4'
export IsCharAlphaW='_IsCharAlphaW@4'
export IsCharAlphaNumericA='_IsCharAlphaNumericA@4'
export IsCharAlphaNumericW='_IsCharAlphaNumericW@4'
export IsCharUpperA='_IsCharUpperA@4'
export IsCharLowerA='_IsCharLowerA@4'
export IsCharUpperW='_IsCharUpperW@4'
export IsCharLowerW='_IsCharLowerW@4'
export CharNextA='_CharNextA@4'
export CharPrevA='_CharPrevA@8'
export wsprintfA='_wsprintfA'
export wsprintfW='_wsprintfW'
export wvsprintfA='_wvsprintfA@12'
export wvsprintfW='_wvsprintfW@12'
export MessageBoxA='_MessageBoxA@16'
export MessageBoxW='_MessageBoxW@16'
export MessageBoxExA='_MessageBoxExA@20'
export MessageBoxExW='_MessageBoxExW@20'
export GetKeyState='_GetKeyState@4'
export GetAsyncKeyState='_GetAsyncKeyState@4'
export GetSystemMetrics='_GetSystemMetrics@4'
export CharToOemA='_CharToOemA@8'
export OemToCharA='_OemToCharA@8'
export CharToOemW='_CharToOemW@8'
export OemToCharW='_OemToCharW@8'
export CharToOemBuffA='_CharToOemBuffA@12'
export OemToCharBuffA='_OemToCharBuffA@12'
export CharToOemBuffW='_CharToOemBuffW@12'
export OemToCharBuffW='_OemToCharBuffW@12'
