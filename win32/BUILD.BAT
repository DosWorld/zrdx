@echo off
rem Win32 DLLs of the ZRDX PE service (task 178).
rem -s: no stack check call, -ecc: cdecl by default; the API
rem functions are declared WINAPI (__stdcall) in the sources.
if exist KERNEL32.DLL del KERNEL32.DLL
if exist USER32.DLL del USER32.DLL
if exist MSVCRT.DLL del MSVCRT.DLL
if exist UCRTBASE.DLL del UCRTBASE.DLL
if exist NTDLL.DLL del NTDLL.DLL
if exist ADVAPI32.DLL del ADVAPI32.DLL
if exist SHELL32.DLL del SHELL32.DLL
if exist *.OBJ del *.OBJ
if "%1"=="trace" set TR=-dW32TRACE
if exist BUILD.LOG del BUILD.LOG
set CF=-zq -s -ecc -fpi87 -bt=nt -i=..\sdk %TR%
wcc386 %CF% -fr=KERNEL32.ERR KERNEL32.C
if exist KERNEL32.ERR type KERNEL32.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32FILE.ERR K32FILE.C
if exist K32FILE.ERR type K32FILE.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32MEM.ERR K32MEM.C
if exist K32MEM.ERR type K32MEM.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32OBJ.ERR K32OBJ.C
if exist K32OBJ.ERR type K32OBJ.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32STR.ERR K32STR.C
if exist K32STR.ERR type K32STR.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32ENV.ERR K32ENV.C
if exist K32ENV.ERR type K32ENV.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32TIME.ERR K32TIME.C
if exist K32TIME.ERR type K32TIME.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32PROC.ERR K32PROC.C
if exist K32PROC.ERR type K32PROC.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32HEAP.ERR K32HEAP.C
if exist K32HEAP.ERR type K32HEAP.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32TLS.ERR K32TLS.C
if exist K32TLS.ERR type K32TLS.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32TEB.ERR K32TEB.C
if exist K32TEB.ERR type K32TEB.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32EXC.ERR K32EXC.C
if exist K32EXC.ERR type K32EXC.ERR >> BUILD.LOG
nasm -f obj K32EXA.ASM -o K32EXA.OBJ
wcc386 %CF% -fr=K32FS.ERR K32FS.C
if exist K32FS.ERR type K32FS.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32FIND.ERR K32FIND.C
if exist K32FIND.ERR type K32FIND.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32CP.ERR K32CP.C
if exist K32CP.ERR type K32CP.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32TXT.ERR K32TXT.C
if exist K32TXT.ERR type K32TXT.ERR >> BUILD.LOG
wcc386 %CF% -fr=K32CON.ERR K32CON.C
if exist K32CON.ERR type K32CON.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTMEM.ERR CRTMEM.C
if exist CRTMEM.ERR type CRTMEM.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTIO.ERR CRTIO.C
if exist CRTIO.ERR type CRTIO.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTFILE.ERR CRTFILE.C
if exist CRTFILE.ERR type CRTFILE.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTFLT.ERR CRTFLT.C
if exist CRTFLT.ERR type CRTFLT.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTFMT.ERR CRTFMT.C
if exist CRTFMT.ERR type CRTFMT.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTCONV.ERR CRTCONV.C
if exist CRTCONV.ERR type CRTCONV.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTSCAN.ERR CRTSCAN.C
if exist CRTSCAN.ERR type CRTSCAN.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTSTR.ERR CRTSTR.C
if exist CRTSTR.ERR type CRTSTR.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTCTYP.ERR CRTCTYP.C
if exist CRTCTYP.ERR type CRTCTYP.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTLIB.ERR CRTLIB.C
if exist CRTLIB.ERR type CRTLIB.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTTIME.ERR CRTTIME.C
if exist CRTTIME.ERR type CRTTIME.ERR >> BUILD.LOG
nasm -f obj CRTM.ASM -o CRTM.OBJ
nasm -f obj CRTJMP.ASM -o CRTJMP.OBJ
wcc386 %CF% -fr=CRTUCRT.ERR CRTUCRT.C
if exist CRTUCRT.ERR type CRTUCRT.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTWFMT.ERR CRTWFMT.C
if exist CRTWFMT.ERR type CRTWFMT.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTWSCN.ERR CRTWSCN.C
if exist CRTWSCN.ERR type CRTWSCN.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTSIG.ERR CRTSIG.C
if exist CRTSIG.ERR type CRTSIG.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTWCS.ERR CRTWCS.C
if exist CRTWCS.ERR type CRTWCS.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTMATH.ERR CRTMATH.C
if exist CRTMATH.ERR type CRTMATH.ERR >> BUILD.LOG
wcc386 %CF% -fr=CRTMAIN.ERR CRTMAIN.C
if exist CRTMAIN.ERR type CRTMAIN.ERR >> BUILD.LOG
wcc386 %CF% -fr=USER32.ERR USER32.C
if exist USER32.ERR type USER32.ERR >> BUILD.LOG
wcc386 %CF% -fr=U32FMT.ERR U32FMT.C
if exist U32FMT.ERR type U32FMT.ERR >> BUILD.LOG
wcc386 %CF% -fr=U32MISC.ERR U32MISC.C
if exist U32MISC.ERR type U32MISC.ERR >> BUILD.LOG
wlink @KERNEL32.LNK >> BUILD.LOG
wlink @USER32.LNK >> BUILD.LOG
wcc386 %CF% -fr=NTDLL.ERR NTDLL.C
if exist NTDLL.ERR type NTDLL.ERR >> BUILD.LOG
wlink @NTDLL.LNK >> BUILD.LOG
wcc386 %CF% -fr=ADVAPI32.ERR ADVAPI32.C
if exist ADVAPI32.ERR type ADVAPI32.ERR >> BUILD.LOG
wlink @ADVAPI32.LNK >> BUILD.LOG
wcc386 %CF% -fr=SHELL32.ERR SHELL32.C
if exist SHELL32.ERR type SHELL32.ERR >> BUILD.LOG
wlink @SHELL32.LNK >> BUILD.LOG
wlink @MSVCRT.LNK >> BUILD.LOG
wlink @UCRTBASE.LNK >> BUILD.LOG
if not exist KERNEL32.DLL echo KERNEL32.DLL NOT BUILT>>BUILD.LOG
if not exist USER32.DLL echo USER32.DLL NOT BUILT >> BUILD.LOG
if not exist NTDLL.DLL echo NTDLL.DLL NOT BUILT >> BUILD.LOG
if not exist ADVAPI32.DLL echo ADVAPI32.DLL NOT BUILT>>BUILD.LOG
if not exist SHELL32.DLL echo SHELL32.DLL NOT BUILT >> BUILD.LOG
if not exist MSVCRT.DLL echo MSVCRT.DLL NOT BUILT >> BUILD.LOG
if not exist UCRTBASE.DLL echo UCRTBASE.DLL NOT BUILT>>BUILD.LOG
