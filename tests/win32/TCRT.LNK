import __controlfp MSVCRT._controlfp
import __fpreset MSVCRT._fpreset
import ___p__fmode MSVCRT.__p__fmode
import ___p___initenv MSVCRT.__p___initenv
import __acmdln MSVCRT._acmdln
import ___zrdx_split MSVCRT.__zrdx_split
